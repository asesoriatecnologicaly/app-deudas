# Base de datos de la aplicacion: PostgreSQL en Supabase.
# IMPORTANTE: usar la cadena del "Session pooler", NO la "Direct connection".
# La directa es IPv6-only y Hostinger no la puede alcanzar.
DATABASE_URL="postgresql://postgres.REFERENCIA:PASSWORD@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

PORT=4000
FRONTEND_URL="https://pale.asesoriatecnologicaly.com"

# --- Solo para los scripts de migracion (scripts/), no los usa la app ---
# Base MySQL vieja de Hostinger, conservada como respaldo.
DATABASE_URL_MYSQL="mysql://USUARIO:PASSWORD@HOST:3306/NOMBRE_BASE_DE_DATOS"
# Misma base que DATABASE_URL; la usa el script de importacion.
DATABASE_URL_PG="postgresql://postgres.REFERENCIA:PASSWORD@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"
